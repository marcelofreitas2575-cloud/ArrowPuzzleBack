# Copie para local.properties (não commitado):
#   copy local.properties.example local.properties
#
# Caminho do Android SDK (command-line tools instalados na sua máquina).
sdk.dir=C\:\\Android\\sdk

# Host do backend na rede local.
# Emulador: 10.0.2.2
# Celular físico (mesmo Wi-Fi): IP da sua PC, ex. 192.168.1.42
dev.host=10.0.2.2

# Opcional: URL pública do Keycloak (ngrok) só para login Google no celular.
# dev.keycloak.publicUrl=https://SEU-SUBDOMINIO.ngrok-free.app
