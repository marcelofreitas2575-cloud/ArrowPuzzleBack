# Copie para .env:  copy .env.example .env
# IP da PC na Wi‑Fi (mesmo valor de android/local.properties dev.host)
DEV_HOST=192.168.0.38

# Token compartilhado sidecar Dapr → rotas /dapr/* nos microsserviços (dev local)
DAPR_APP_API_TOKEN=dev-local-dapr-app-api-token

# Título na UI do app (GET /api/v1/product) — reinicie o gateway após alterar
PRODUCT_DISPLAY_NAME=Arrow Puzzle

# Google (opcional, login adiado):

# Google Cloud → OAuth 2.0 → Web client (obrigatório para login com Google)
GOOGLE_IDP_CLIENT_ID=
GOOGLE_IDP_CLIENT_SECRET=

# URL que o CELULAR usa para abrir o Keycloak (IP da PC na Wi‑Fi)
KEYCLOAK_FRONTEND_URL=http://192.168.0.38:8080

# Cole o MESMO redirect URI cadastrado no Google Cloud
KEYCLOAK_PUBLIC_REDIRECT_URI=http://192.168.0.38:8080/realms/arrow-puzzle/broker/google/endpoint

# Com ngrok (Passo 1b em CONFIGURAR_GOOGLE.md):
# KEYCLOAK_PUBLIC_BASE_URL=https://SEU-SUBDOMINIO.ngrok-free.app
