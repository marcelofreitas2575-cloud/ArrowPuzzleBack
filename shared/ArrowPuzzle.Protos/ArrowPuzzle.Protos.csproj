<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\gamesession\v1\gamesession.proto" GrpcServices="Both" Link="Protos\gamesession\v1\gamesession.proto" />
    <Protobuf Include="Protos\playerprogress\v1\playerprogress.proto" GrpcServices="Both">
      <AdditionalImportDirs>$(MSBuildThisFileDirectory)Protos</AdditionalImportDirs>
    </Protobuf>
    <Protobuf Include="Protos\levelcatalog\v1\levelcatalog.proto" GrpcServices="Both">
      <AdditionalImportDirs>$(MSBuildThisFileDirectory)Protos</AdditionalImportDirs>
    </Protobuf>
  </ItemGroup>
</Project>
